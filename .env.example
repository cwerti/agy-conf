# ==============================================================================
# Universal Agent Configuration Environment Variables
# Copy to your system environment variables or .env (which is git-ignored)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Personal Memory & Documentation Repository
# ------------------------------------------------------------------------------
# URL of your personal GitHub repository for storing agent memory, sessions, and configs.
# e.g., https://github.com/your-username/agent-memory.git
AGENT_MEMORY_REPO_URL=https://github.com/your-username/agent-memory.git
# Optional local path to your cloned memory repo (defaults to ../agent-memory if exists)
AGENT_MEMORY_PATH=../agent-memory

# ------------------------------------------------------------------------------
# 2. VCS & Issue Tracker Tokens
# ------------------------------------------------------------------------------
# Personal GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Work Self-hosted GitLab
GITLAB_URL=https://gitlab.uriit.ru/api/v4
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Work JetBrains YouTrack
YOUTRACK_BASE_URL=https://youtrack.uriit.ru
YOUTRACK_PERMANENT_TOKEN=perm:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. Backend Dev Services (PostgreSQL & Redis for FastAPI)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db
REDIS_URL=redis://localhost:6379/0
